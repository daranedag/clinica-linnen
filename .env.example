# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# InsForge public read client. Leave empty to use the local content fallback.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_CONTENT_TABLE=site_content

# Image delivery only. Never expose the ImageKit private key to the browser.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# WhatsApp number without spaces or +
NEXT_PUBLIC_WHATSAPP_NUMBER=56920953624
